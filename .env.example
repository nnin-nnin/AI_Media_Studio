# AI Media Studio Environment Configuration
PORT=3000
NODE_ENV=development
DEBUG=false
SKIP_AUTH=true
USE_REDIS_QUEUE=false
DATABASE_URL="file:../data/ai_course.sqlite"

# Volcengine Ark API Key (Doubao Seedream Image / Video / Realtime Vision)
# Obtain from https://console.volcengine.com/ark
ARK_API_KEY=

# DashScope API Key (Optional, for CosyVoice audio)
DASHSCOPE_API_KEY=

# Decart API Key (Optional)
DECART_API_KEY=

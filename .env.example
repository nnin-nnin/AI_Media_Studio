# 基础服务配置（默认无需修改）
PORT=3000
NODE_ENV=development
DEBUG=true
SKIP_AUTH=true
USE_REDIS_QUEUE=false
DATABASE_URL="file:../data/ai_course.sqlite"

# ==========================================================
# AI 服务密钥配置（也可启动网站后直接点击页面上的【⚙️ API 配置】填写）
# ==========================================================

# 1. 火山引擎豆包大模型 API Key（必填：用于 AI 变脸/生图、视频生成）
ARK_API_KEY=

# 2. 阿里云百炼 DashScope API Key（选填：用于语音识别、AI角色语音对话、声音克隆）
DASHSCOPE_API_KEY=

# 3. Decart AI API Key（选填：用于实时视觉 AI 魔镜）
DECART_API_KEY=

# 4. 腾讯云 COS 对象存储（选填：仅在“声音克隆”上传本地录音复刻新音色时需要）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_COS_BUCKET=
TENCENT_COS_REGION=ap-beijing


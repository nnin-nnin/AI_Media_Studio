  "author": "Zhengmin Yu",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "export DEBUG=true && node --watch src/server/server.js",
    "client:dev": "vite",
    "db:push": "prisma db push",

{
  "name": "AI-Media-Studio",
  "version": "1.0.0",
  "main": "src/server/server.js",
  "type": "module",
  "author": "Zhengmin Yu",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\" \"npm run worker\"",
    "server:dev": "npm run db:seed && export DEBUG=true && node --watch src/server/server.js",
    "client:dev": "vite",
    "worker": "node src/server/start-worker.js",
    "db:push": "prisma db push",
    "db:seed": "node scripts/seed_all.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "vitest run src/server/tests/e2e/studio.e2e.test.js",
    "pack": "bash scripts/package_release.sh",
    "start": "concurrently \"npm run db:seed && node src/server/server.js\" \"npm run worker\""
  },
  "license": "MIT",
  "dependencies": {
    "@decartai/sdk": "^0.0.27",
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/drawing_utils": "^0.3.1675466124",
    "@mediapipe/hands": "^0.4.1675469240",
    "axios": "^1.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.5.0",
    "body-parser": "^2.2.1",
    "bullmq": "^5.66.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "openai": "^4.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "concurrently": "^8.2.2",
    "prisma": "^5.22.0",
    "supertest": "^7.1.4",
    "vite": "^5.2.0",
    "vitest": "^4.0.16"
  },
  "prisma": {
    "seed": "node scripts/seed_all.js"
  }
}
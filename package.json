{
  "name": "ai-course",
  "version": "1.0.0",
  "description": "AI多媒体课程项目",
  "main": "src/main/main.js",
  "type": "module",
  "author": "Damian Yu",
  "build": {
    "appId": "com.example.myapp",
    "productName": "AICourse",
    "copyright": "Copyright © 2025 Damian Yu",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "scripts": {
    "start": "node src/server/server.js",
    "start:electron": "electron .",
    "build": "electron-builder"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "electron-reload": "^2.0.0-alpha.1"
  },
  "dependencies": {
    "axios": "^1.0.0",
    "body-parser": "^2.2.1",
    "chokidar": "^4.0.3",
    "cors": "^2.8.5",
    "electron-squirrel-startup": "^1.0.1",
    "express": "^5.2.1",
    "openai": "^4.0.0"
  }
}
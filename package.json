{
  "name": "AI-Media-Studio",
  "version": "1.0.0",
  "description": "Cross-platform AI creation studio featuring Image Creation & Face Swap, Video Generation, Character Voice Chat, and Realtime Vision, powered by Volcengine Ark & Doubao models.",
  "main": "electron/main.js",
  "type": "module",
  "author": "Zhengmin Yu",
  "homepage": "https://github.com/nnin-nnin/AI_Media_Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nnin-nnin/AI_Media_Studio.git"
  },
  "keywords": [
    "ai",
    "electron",
    "volcengine",
    "doubao",
    "face-swap",
    "video-generation",
    "voice-chat",
    "text-to-image",
    "desktop-app",
    "cross-platform"
  ],
  "bugs": {
    "url": "https://github.com/nnin-nnin/AI_Media_Studio/issues"
  },
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\" \"npm run worker\"",
    "server:dev": "npm run db:seed && export DEBUG=true && node --watch src/server/server.js",
    "client:dev": "vite",
    "worker": "node src/server/start-worker.js",
    "db:push": "prisma db push",
    "db:seed": "node scripts/seed_all.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "vitest run src/server/tests/e2e/studio.e2e.test.js",
    "pack": "bash scripts/package_release.sh",
    "start": "concurrently \"npm run db:seed && node src/server/server.js\" \"npm run worker\"",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "build:mac": "npm run build && electron-builder --mac",
    "build:win": "npm run build && electron-builder --win"
  },
  "license": "MIT",
  "dependencies": {
    "@decartai/sdk": "^0.0.27",
    "axios": "^1.0.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.1",
    "bullmq": "^5.66.2",
    "cors": "^2.8.5",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "ioredis": "^5.8.2",
    "multer": "^2.0.2",
    "openai": "^4.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "playwright": "^1.64.1",
    "prisma": "^5.22.0",
    "supertest": "^7.1.4",
    "vite": "^5.2.0",
    "vitest": "^4.0.16",
    "wait-on": "^9.5.1",
    "yaml": "^2.9.1"
  },
  "prisma": {
    "seed": "node scripts/seed_all.js"
  }
}

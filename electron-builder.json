{
  "appId": "com.aimediastudio.app",
  "productName": "AI 媒体工作室",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "src/server/**/*",
    "prisma/**/*",
    "data/ai_course.sqlite",
    "node_modules/**/*",
    "node_modules/.prisma/**/*",
    "package.json"
  ],
  "asarUnpack": [
    "src/server/db/generated/client/**/*",
    "node_modules/@prisma/client/**/*"
  ],
  "extraResources": [
    {
      "from": "data/ai_course.sqlite",
      "to": "data/ai_course.sqlite"
    }
  ],
  "mac": {
    "icon": "build/icon.icns",
    "category": "public.app-category.graphics-design",
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64", "x64"]
      },
      {
        "target": "zip",
        "arch": ["arm64", "x64"]
      }
    ],
    "hardenedRuntime": false,
    "gatekeeperAssess": false
  },
  "win": {
    "icon": "build/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "AI 媒体工作室"
  }
}
